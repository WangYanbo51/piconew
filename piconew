chmod +x "$PROJ_DIR/build.sh"

# ---------------- .gitignore ----------------
cat > "$PROJ_DIR/.gitignore" <<'EOF'
build/
*.uf2
*.elf
*.bin
*.hex
*.dis
*.map
EOF

# ---------------- 工程 README ----------------
{
  echo "# $NAME"
  echo ''
  echo "Pico SDK 工程，由 piconew 生成。"
  echo ''
  echo "## 配置"
  echo ''
  echo "| 项目 | 值 |"
  echo "|---|---|"
  echo "| 开发板 | \`$BOARD\` |"
  echo "| 内核架构 | \`$ARCH\`（平台 \`$PLATFORM\`） |"
  echo "| 语言 | \`$LANG_SEL\` |"
  echo "| 串口 | \`$STDIO_SEL\` |"
  echo "| 功能库 | \`${LIBS_SEL:-无}\` |"
  echo "| 起始代码 | \`$STARTER\` |"
  echo ''
  echo "## 常用命令"
  echo ''
  echo '```bash'
  echo './build.sh          # 编译'
  echo './build.sh flash    # 编译并烧录'
  echo './build.sh monitor  # 看串口输出'
  echo './build.sh info     # 打印当前工程信息'
  echo './build.sh clean    # 清理'
  echo '```'
  echo ''
  echo "看串口输出用 \`./build.sh monitor\`（退出：Ctrl+A 然后 X）"
  echo ''
  echo "## 加代码"
  echo ''
  echo "往 \`src/\` 里丢 \`.c\` 或 \`.cpp\` 文件即可，CMake 会自动收集，不用改 CMakeLists。"
} > "$PROJ_DIR/README.md"

# ---------------- 完成 ----------------
save_last

echo ''
ok "工程已创建：$PROJ_DIR"
echo ''
printf '  %s\n' "$PROJ_DIR/CMakeLists.txt"
printf '  %s\n' "$SRC_FILE"
[[ $PIO_TEMPLATE -eq 1 ]] && printf '  %s\n' "$PROJ_DIR/src/square_wave.pio"
printf '  %s\n' "$PROJ_DIR/build.sh"
printf '  %s\n' "$PROJ_DIR/README.md"
echo ''
info "下一步："
echo "  cd $PROJ_DIR && ./build.sh"
if [[ "$STARTER" == "pio" ]]; then
  echo ""
  echo "  PIO 头文件由 CMake 自动生成，不需要手工运行 pioasm"
fi
