#!/usr/bin/env bash
# =============================================================
#  piconew —— Pico SDK 工程生成器
#  交互式创建带选项的工程骨架，生成即可编译
# =============================================================
set -euo pipefail

PICO_ROOT="${PICO_ROOT:-$HOME/pico}"
SDK_PATH="${PICO_SDK_PATH:-$HOME/pico/pico-sdk}"
CONF_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/piconew/last.conf"

# 默认方案：Pico 2 / ARM / C++ / USB 串口 / 不选功能库 / 空模板
DEF_BOARD="pico2"
DEF_ARCH="arm"
DEF_LANG="cpp"
DEF_STDIO="usb"
DEF_LIBS=""
DEF_STARTER="empty"

NAME=""
BOARD=""
ARCH=""
LANG_SEL=""
STDIO_SEL=""
LIBS_SEL=""
STARTER=""
ASSUME_DEFAULT=0
HAS_OPT=0
PRINT_BUILD_SH=0
SCHEME_CHOSEN=0

die() { printf '\033[31m错误：%s\033[0m\n' "$*" >&2; exit 1; }
info() { printf '\033[36m%s\033[0m\n' "$*"; }
ok() { printf '\033[32m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*"; }

# 项目内 build.sh 的唯一来源：既写入新工程，也能用 --print-build-sh 打印出来
emit_build_sh() {
cat <<'BUILDEOF'
#!/usr/bin/env bash
# =============================================================
#  ./build.sh          编译
#  ./build.sh flash    编译并烧录（板子不在 BOOTSEL 会自动复位）
#  ./build.sh reset    只把板子复位进 BOOTSEL，不编译
#  ./build.sh monitor  打开串口看输出（Ctrl+A 然后 X 退出）
#  ./build.sh info     打印当前工程信息（板型、平台、工具链、产物等）
#  ./build.sh clean    清理（保留 compile_commands.json）
# =============================================================
set -e

BUILD_DIR="build"
BOOTSEL_TIMEOUT=20      # 等 U 盘出现的最大秒数
SDK_DIR="${PICO_SDK_PATH:-$HOME/pico/pico-sdk}"

# ---------- 找 BOOTSEL 挂载点 ----------
find_mount() {
    local d m
    for d in /run/media/"$USER" /media/"$USER" /run/media; do
        [ -d "$d" ] || continue
        m=$(find "$d" -maxdepth 1 -type d \( -name 'RP2350*' -o -name 'RPI-RP2*' \) 2>/dev/null | head -1)
        if [ -n "$m" ]; then
            echo "$m"
            return 0
        fi
    done
    return 1
}

# ---------- 找 BOOTSEL 块设备（没自动挂载时用） ----------
find_blockdev() {
    local listing name label
    listing=$(lsblk -rno NAME,LABEL 2>/dev/null) || return 1
    while read -r name label; do
        case "$label" in
            RP2350*|RPI-RP2*)
                printf '/dev/%s\n' "$name"
                return 0
                ;;
        esac
    done <<< "$listing"
    return 1
}

# ---------- 自动挂载（不需要 sudo） ----------
auto_mount() {
    local dev="$1"
    if udisksctl mount -b "$dev" >/dev/null 2>&1; then
        return 0
    fi
    echo "  自动挂载失败，手动挂：" >&2
    echo "    sudo mkdir -p /mnt/pico && sudo mount $dev /mnt/pico" >&2
    echo "  然后把 .uf2 复制进 /mnt/pico/" >&2
    return 1
}

# ---------- 找 Pico 的串口 ----------
# 靠 USB VID 2e8a 识别，避免误抓蓝牙、摄像头之类的 /dev/ttyACM*
find_serial() {
    local dev vid
    for dev in /dev/ttyACM*; do
        [ -e "$dev" ] || continue
        vid=$(cat "/sys/class/tty/$(basename "$dev")/device/../idVendor" 2>/dev/null || true)
        if [ "$vid" = "2e8a" ]; then
            echo "$dev"
            return 0
        fi
    done
    return 1
}

# ---------- 把运行中的板子复位进 BOOTSEL ----------
reset_to_bootsel() {
    local dev="$1"

    if command -v picotool >/dev/null 2>&1; then
        echo "  尝试 picotool reboot -f -u ..." >&2
        if picotool reboot -f -u >/dev/null 2>&1; then
            echo "  picotool 已发出复位命令" >&2
            return 0
        fi
        echo "  picotool 失败，改用 1200 波特率" >&2
    fi

    echo "  用 1200 波特率触发复位: $dev" >&2
    if stty -F "$dev" 1200 2>/dev/null; then
        return 0
    fi

    if command -v python3 >/dev/null 2>&1; then
        if python3 -c 'import serial,sys; s=serial.Serial(sys.argv[1],1200,timeout=1); s.close()' "$dev" >/dev/null 2>&1; then
            echo "  stty 失败，pyserial 成功" >&2
            return 0
        fi
    fi

    echo "  复位失败：stty 和 pyserial 都没成功" >&2
    echo "  如果 picocom 或串口助手正占用该端口，请先退出" >&2
    return 1
}

# ---------- 有块设备但没自动挂载时，挂上并返回挂载点 ----------
ensure_mounted() {
    local dev
    dev=$(find_blockdev) || return 1
    auto_mount "$dev" || return 1
    find_mount
}

# ---------- 等挂载点出现 ----------
# 每轮都顺带处理「设备已经在，但桌面没给挂载」的情况
wait_mount() {
    local limit="$1" i m
    for ((i = 0; i < limit * 2; i++)); do
        if m=$(find_mount) || m=$(ensure_mounted); then
            echo "$m"
            return 0
        fi
        sleep 0.5
    done
    return 1
}

# ---------- 保证板子处于 BOOTSEL，成功时把挂载点打到 stdout ----------
# 所有提示走 stderr，这样调用方可以 MOUNT=$(ensure_bootsel)
ensure_bootsel() {
    local mount dev

    if mount=$(find_mount); then
        echo "板子已在 BOOTSEL: $mount" >&2
        echo "$mount"
        return 0
    fi

    if mount=$(ensure_mounted); then
        echo "板子在 BOOTSEL，已自动挂载: $mount" >&2
        echo "$mount"
        return 0
    fi

    if dev=$(find_serial); then
        echo "检测到板子在运行模式（$dev），不是 BOOTSEL" >&2
        if ! reset_to_bootsel "$dev"; then
            return 1
        fi
        echo "  等待 U 盘出现，最多 ${BOOTSEL_TIMEOUT}s ..." >&2
        if mount=$(wait_mount "$BOOTSEL_TIMEOUT"); then
            echo "  已进入 BOOTSEL: $mount" >&2
            echo "$mount"
            return 0
        fi
        echo "  超时没等到 U 盘。程序可能已卡死，只能按住 BOOTSEL 重新插拔。" >&2
        return 1
    fi

    echo "没找到板子：既没有 BOOTSEL 的 U 盘，也没有串口设备" >&2
    echo "请检查 USB 线，或按住 BOOTSEL 键插上" >&2
    return 1
}

# ---------- 打开串口看输出 ----------
monitor() {
    local dev
    if ! dev=$(find_serial); then
        echo "没找到 Pico 的串口（/dev/ttyACM* 里没有 VID 2e8a 的设备）" >&2
        echo "板子插上了吗？程序在跑吗？（在 BOOTSEL 里是不会出串口的）" >&2
        return 1
    fi
    if ! command -v picocom >/dev/null 2>&1; then
        echo "没装 picocom：sudo pacman -S picocom" >&2
        return 1
    fi
    echo "串口 $dev，波特率 115200"
    echo "退出：先按 Ctrl+A，松手，再按 X"
    echo ""
    picocom -b 115200 "$dev"
}

# ---------- 打印当前工程信息 ----------
# 全部从 CMakeLists.txt 与实际文件现场读取，不依赖额外的记录文件
cmake_value() {   # 取 set(KEY value) 里的 value
    grep -oP "set\(\s*$1\s+\K[^\)\s]+" CMakeLists.txt 2>/dev/null | head -1
}

show_info() {
    local name board platform arch chip fam expect derived
    local usb uart stdio libs srcs pio sdkver tc dev uf2 size

    name=$(cmake_value PROJECT_NAME)
    if [ -z "$name" ]; then
        echo "没能从 CMakeLists.txt 读到 PROJECT_NAME（当前目录是工程根目录吗？）" >&2
        return 1
    fi
    board=$(cmake_value PICO_BOARD)
    platform=$(cmake_value PICO_PLATFORM)

    # 没写 PICO_PLATFORM 的老工程，按 SDK 的默认推导规则补上
    derived="$platform"
    if [ -z "$derived" ]; then
        case "$board" in
            pico2|pico2_w) derived="rp2350-arm-s" ;;
            pico|pico_w)   derived="rp2040" ;;
        esac
    fi

    # 架构由平台名推断，RP2040 与 rp2350-arm-s 都是 ARM
    case "$derived" in
        *riscv*) arch="RISC-V" ;;
        *)       arch="ARM" ;;
    esac

    # 串口方式：看 CMakeLists 里的两个开关
    usb=$(grep -oP 'pico_enable_stdio_usb\(\$\{PROJECT_NAME\}\s+\K[01]' CMakeLists.txt 2>/dev/null | head -1)
    uart=$(grep -oP 'pico_enable_stdio_uart\(\$\{PROJECT_NAME\}\s+\K[01]' CMakeLists.txt 2>/dev/null | head -1)
    usb=${usb:-0}
    uart=${uart:-0}
    if [ "$usb" = 1 ] && [ "$uart" = 1 ]; then
        stdio="USB + UART"
    elif [ "$usb" = 1 ]; then
        stdio="USB"
    elif [ "$uart" = 1 ]; then
        stdio="UART"
    else
        stdio="无"
    fi

    # 链接的库：target_link_libraries 块内每行一个库名
    libs=$(sed -n '/^target_link_libraries/,/^)/p' CMakeLists.txt 2>/dev/null \
           | grep -oE '^[[:space:]]+[A-Za-z0-9_]+' | tr -d ' ' | paste -sd' ' -)

    srcs=$(ls src/*.c src/*.cpp 2>/dev/null | xargs -r -n1 basename | paste -sd' ' -)
    if [ -z "$srcs" ]; then
        srcs="无"
    fi
    pio=""
    if ls src/*.pio >/dev/null 2>&1; then
        pio=$(ls src/*.pio | xargs -n1 basename | paste -sd' ' -)
    fi

    sdkver=""
    if [ -f "$SDK_DIR/pico_sdk_version.cmake" ]; then
        sdkver=$(grep -oP 'set\(PICO_SDK_VERSION_(MAJOR|MINOR|REVISION)\s+\K[0-9]+' \
                 "$SDK_DIR/pico_sdk_version.cmake" | paste -sd. -)
    fi

    # 工具链：以平台决定该用哪一套
    tc=""
    case "$derived" in
        *riscv*)
            for t in riscv32-pico-elf riscv32-unknown-elf riscv32-corev-elf riscv-none-elf; do
                if command -v "$t-gcc" >/dev/null 2>&1; then
                    tc="$t-gcc $("$t-gcc" -dumpversion 2>/dev/null)"
                    break
                fi
            done
            ;;
        *)
            if command -v arm-none-eabi-gcc >/dev/null 2>&1; then
                tc="arm-none-eabi-gcc $(arm-none-eabi-gcc -dumpversion 2>/dev/null)"
            fi
            ;;
    esac

    echo "工程：$name"
    echo "路径：$(pwd)"
    echo "开发板：${board:-未设置（SDK 默认 pico / RP2040）}"
    if [ -z "$platform" ]; then
        echo "平台：${derived:-未设置}（$arch，CMakeLists 未显式设置，按开发板默认）"
    else
        echo "平台：$platform（$arch）"
    fi
    echo "串口：$stdio"
    echo "链接库：${libs:-无}"
    echo "源文件：$srcs"
    if [ -n "$pio" ]; then
        echo "PIO 文件：$pio"
    fi
    echo "SDK：$SDK_DIR${sdkver:+（$sdkver）}"
    echo "工具链：${tc:-未找到}"

    uf2="$BUILD_DIR/$name.uf2"
    if [ -f "$uf2" ]; then
        size=$(du -h "$uf2" | cut -f1)
        # UF2 每个 512 字节块的第 0x1C 字节起是芯片标识，小端存放；
        # 取 image 模式下 blockNo 为 0 的那一块，而非文件首块（后者可能是 ABS 块）
        fam=$(uf2_family "$uf2")
        case "$fam" in
            0xe48bff56) chip="RP2040" ;;
            0xe48bff57) chip="绝对地址（ABS 块）" ;;
            0xe48bff59) chip="RP2350 ARM-S" ;;
            0xe48bff5a) chip="RP2350 RISC-V" ;;
            *)          chip="未知标识" ;;
        esac
        echo "产物：$uf2（$size，${chip}，$(date -r "$uf2" '+%Y-%m-%d %H:%M')）"

        # 平台与产物芯片标识不符，说明 build/ 里是旧配置编出来的
        case "$derived" in
            *riscv*) expect="0xe48bff5a" ;;
            rp2350*) expect="0xe48bff59" ;;
            rp2040*) expect="0xe48bff56" ;;
            *)       expect="" ;;
        esac
        if [ -n "$expect" ] && [ "$fam" != "$expect" ]; then
            echo "警告：产物芯片标识与平台不一致（期望 $expect，实际 $fam），build/ 可能是旧的，先执行 ./build.sh clean"
        fi
    else
        echo "产物：未编译（没找到 $uf2）"
    fi

    if dev=$(find_serial); then
        echo "串口设备：$dev"
    else
        echo "串口设备：未检测到（没插板子，或板子在 BOOTSEL 模式）"
    fi
}

# 读 UF2 的芯片标识，输出形如 0xe48bff59
# 优先取 blockNo 为 0 且非 ABS 的块；不存在时退回文件首块
uf2_family() {
    /usr/bin/env python3 - "$1" 2>/dev/null <<'PYEOF'
import struct, sys
d = open(sys.argv[1], 'rb').read()
counts = {}
order = []
for off in range(0, len(d) - 511, 512):
    b = d[off:off + 512]
    if b[:4] != b'UF2\n' or struct.unpack('<I', b[4:8])[0] != 0x9e5d5157:
        continue
    flags = struct.unpack('<I', b[8:12])[0]
    fam = struct.unpack('<I', b[28:32])[0]
    # 0x1 = NOT_MAIN_FLASH，ABS 块的 family 是 ABSOLUTE_FAMILY_ID，与芯片无关
    if flags & 0x1:
        continue
    key = '0x%08x' % fam
    if key not in counts:
        counts[key] = 0
        order.append(key)
    counts[key] += 1
print(max(order, key=lambda k: counts[k]) if counts else '0x00000000')
PYEOF
}

# ---------- 生成 clangd 可直接使用的编译数据库 ----------
# CMake 导出的 compile_commands.json 原样给 clangd 用不了，原因有三：
#   1) 没有 --target，clangd 按宿主 x86_64 解析，-mcpu=cortex-m33 直接报错
#   2) newlib / libstdc++ 的头路径由 gcc 驱动隐式提供，数据库里没有，<cstdio> 找不到
#   3) RISC-V 的 -mcpu=hazard3-rp2350 是 GCC 专有 CPU 名，clang 不认
# 这里逐条重写：补 --target、删掉 clang 不认的参数、把驱动提供的系统头显式写成 -isystem，
# 结果放到工程根目录。clangd 从源文件目录逐级向上查找，编辑器侧无需任何配置。
gen_cdb() {
    local src="$1/compile_commands.json"
    [ -f "$src" ] || return 0
    if ! command -v python3 >/dev/null 2>&1; then
        echo "未安装 python3，跳过编译数据库生成"
        return 0
    fi
    python3 - "$src" "./compile_commands.json" <<'PYEOF' || echo "编译数据库生成失败，不影响固件"
import json, os, shlex, subprocess, sys

src, dst = sys.argv[1], sys.argv[2]
db = json.load(open(src))
if not db:
    sys.exit(0)


def argv_of(e):
    return e.get('arguments') or shlex.split(e.get('command', ''))


first = argv_of(db[0])
if not first:
    sys.exit(0)

compiler = first[0]
triple = 'riscv32-unknown-elf' if 'riscv' in os.path.basename(compiler) else 'arm-none-eabi'

# 向编译器本身问出系统头搜索路径
sysinc = []
try:
    p = subprocess.run([compiler, '-E', '-v', '-x', 'c++', '-'],
                       input='', stdout=subprocess.DEVNULL,
                       stderr=subprocess.PIPE, text=True, timeout=60)
    lines = p.stderr.splitlines()
    a = next(i for i, l in enumerate(lines) if 'search starts here' in l)
    b = next(i for i, l in enumerate(lines) if 'End of search list' in l)
    sysinc = [os.path.normpath(l.strip()) for l in lines[a + 1:b] if l.strip()]
except Exception:
    sysinc = []

out = []
for e in db:
    args = argv_of(e)
    keep, i = [], 0
    while i < len(args):
        a = args[i]
        if a == '-o':                 # -o 输出文件与 -c 对 clangd 无用
            i += 2
            continue
        if a == '-c':
            i += 1
            continue
        if a.startswith('-mcpu=hazard3'):
            i += 1
            continue
        keep.append(a)
        i += 1
    if not keep:
        continue
    args = [keep[0], '--target=' + triple] + keep[1:]
    for d in sysinc:
        args += ['-isystem', d]
    out.append({'directory': e['directory'], 'file': e['file'], 'arguments': args})

json.dump(out, open(dst, 'w'), indent=1)
print('编译数据库：compile_commands.json（%d 条，target=%s）' % (len(out), triple))
PYEOF
}

case "${1:-}" in
    monitor|serial|mon)
        monitor || exit 1
        exit 0
        ;;
    info)
        show_info || exit 1
        exit 0
        ;;
    clean)
        if [ -d "$BUILD_DIR" ]; then
            rm -rf "$BUILD_DIR"
        fi
        # 工程根目录的 compile_commands.json 刻意保留，清理后 clangd 仍可解析
        echo "已清理（保留了 compile_commands.json）"
        exit 0
        ;;
    reset)
        MOUNT=$(ensure_bootsel) || exit 1
        echo "已处于 BOOTSEL: $MOUNT"
        exit 0
        ;;
esac

if [ ! -d "$SDK_DIR" ]; then
    echo "找不到 Pico SDK：$SDK_DIR"
    echo "请设置环境变量：export PICO_SDK_PATH=\$HOME/pico/pico-sdk"
    exit 1
fi

PROJECT_NAME=$(grep -oP 'set\(PROJECT_NAME\s+\K[^\)]+' CMakeLists.txt | head -1 | tr -d ' ')
if [ -z "$PROJECT_NAME" ]; then
    echo "没能从 CMakeLists.txt 读到 PROJECT_NAME"
    exit 1
fi
UF2="$BUILD_DIR/$PROJECT_NAME.uf2"

mkdir -p "$BUILD_DIR"
cmake -S . -B "$BUILD_DIR" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON > /dev/null
gen_cdb "$BUILD_DIR"
make -C "$BUILD_DIR" -j"$(nproc)"

if [ ! -f "$UF2" ]; then
    echo "没找到 $UF2"
    exit 1
fi

echo ""
echo "编译完成: $(pwd)/$UF2"
ls -lh "$UF2"

if [ "${1:-}" = "flash" ]; then
    echo ""
    if ! MOUNT=$(ensure_bootsel); then
        exit 1
    fi
    echo "写入 $MOUNT ..."
    cp "$UF2" "$MOUNT/"
    sync
    echo "完成，板子会自动重启运行新固件"
    echo ""
    echo "看串口：./build.sh monitor"
fi
BUILDEOF
}

usage() {
cat <<'EOF'
piconew — 快速创建 Pico SDK 工程

用法：
  piconew                        交互式创建
  piconew 工程名                  指定名字，其余交互
  piconew 工程名 --board pico2 --lang cpp --stdio usb --libs i2c,spi --starter blink
  piconew 工程名 --board pico2 --arch riscv --lang cpp
  piconew 工程名 --default        六项全部使用默认方案，不提问

交互流程第一步可选「创建方案」：
  上次的方案    复用上一次成功创建的选项（记在 ~/.config/piconew/last.conf）
  默认方案      Pico 2 / ARM / C++ / USB 串口 / 不选功能库 / 空模板
  逐项选择      依次问开发板、内核架构、语言、串口、功能库、起始代码

选项：
  --board    pico2 | pico2_w | pico | pico_w      开发板
  --arch     arm | riscv                          内核架构（仅 RP2350 板可用 riscv）
  --lang     c | cpp                              源文件语言
  --stdio    usb | uart | both | none             串口输出方式
  --libs     i2c,spi,pwm,adc,uart,multicore,float,pio   功能库（逗号分隔）
  --starter  blink | serial | pio | empty         起始代码
  --default  六项全部使用默认方案（Pico 2 / ARM / C++ / USB / 无库 / 空模板）
             仅用于完全不指定选项的场合，不能与上面的选项参数同时使用
  --print-build-sh   只把 build.sh 内容打印到 stdout（给已有工程升级用）
  -h, --help 显示本帮助

环境变量：
  PICO_ROOT      工程根目录，默认 ~/pico
  PICO_SDK_PATH  SDK 路径，默认 ~/pico/pico-sdk
EOF
}

# ---------------- 参数解析 ----------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --board)   BOARD="${2:-}"; HAS_OPT=1; shift 2 ;;
    --arch)    ARCH="${2:-}"; HAS_OPT=1; shift 2 ;;
    --lang)    LANG_SEL="${2:-}"; HAS_OPT=1; shift 2 ;;
    --stdio)   STDIO_SEL="${2:-}"; HAS_OPT=1; shift 2 ;;
    --libs)    LIBS_SEL="${2:-}"; HAS_OPT=1; shift 2 ;;
    --starter) STARTER="${2:-}"; HAS_OPT=1; shift 2 ;;
    --print-build-sh) PRINT_BUILD_SH=1; shift ;;
    --default) ASSUME_DEFAULT=1; shift ;;
    -*)        die "未知选项：$1（用 --help 查看用法）" ;;
    *)
      if [[ -z "$NAME" ]]; then NAME="$1"; else die "多余的参数：$1"; fi
      shift ;;
  esac
done

# --default 表示六项全部采用默认方案，与逐项指定互斥
if [[ $ASSUME_DEFAULT -eq 1 && $HAS_OPT -eq 1 ]]; then
  die "--default 与 --board/--arch/--lang/--stdio/--libs/--starter 不能同时使用
--default 要求六项全部使用默认方案；若要指定其中若干项，直接给出这些参数即可，
未给出的项会逐一询问。"
fi

