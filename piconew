# 把六项拼成一行给人看（RP2040 板不显示架构，它只有 ARM）
scheme_desc() {
  local lgs ios out
  case "$3" in cpp) lgs="C++" ;; c) lgs="C" ;; *) lgs="$3" ;; esac
  case "$4" in
    usb)  ios="USB 串口" ;;
    uart) ios="UART" ;;
    both) ios="USB+UART" ;;
    none) ios="无串口" ;;
    *)    ios="$4" ;;
  esac
  out="$(board_name "$1")"
  case "$1" in
    pico2|pico2_w) out+=" / $(arch_name "$2")" ;;
  esac
  printf '%s / %s / %s / %s / %s' \
    "$out" "$lgs" "$ios" "${5:-无库}" "${6:-empty}"
}

# 读上次的方案，成功时按 BOARD|ARCH|LANG|STDIO|LIBS|STARTER 一行输出
read_last() {
  [[ -f "$CONF_FILE" ]] || return 1
  local b="" a="" l="" s="" lb="" st="" k v
  while IFS='=' read -r k v; do
    case "$k" in
      BOARD)   b="$v" ;;
      ARCH)    a="$v" ;;
      LANG)    l="$v" ;;
      STDIO)   s="$v" ;;
      LIBS)    lb="$v" ;;
      STARTER) st="$v" ;;
    esac
  done < "$CONF_FILE"
  [[ -n "$b" && -n "$l" && -n "$s" && -n "$st" ]] || return 1
  [[ -n "$a" ]] || a="$DEF_ARCH"    # 旧版配置里没有 ARCH 行，按 ARM 处理
  printf '%s|%s|%s|%s|%s|%s\n' "$b" "$a" "$l" "$s" "$lb" "$st"
}

# 新建成功后记下来，下次可以直接选
save_last() {
  mkdir -p "$(dirname "$CONF_FILE")"
  {
    printf 'BOARD=%s\n'   "$BOARD"
    printf 'ARCH=%s\n'    "$ARCH"
    printf 'LANG=%s\n'    "$LANG_SEL"
    printf 'STDIO=%s\n'   "$STDIO_SEL"
