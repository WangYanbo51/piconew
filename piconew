    fi
    ;;

  serial)
    if [[ "$LANG_SEL" == "cpp" ]]; then HEAD='#include <cstdio>'; else HEAD='#include <stdio.h>'; fi
cat > "$SRC_FILE" <<EOF
$HEAD
#include "pico/stdlib.h"

int main() {
    stdio_init_all();

    printf("串口就绪，输入字符会回显；输入 q 退出循环\n");

    int count = 0;
    while (true) {
        int c = getchar_timeout_us(0);   // 非阻塞读一个字符
        if (c != PICO_ERROR_TIMEOUT) {
            if (c == 'q') break;
            printf("收到: %c  (累计 %d 个)\n", c, ++count);
        }
        sleep_ms(10);
    }

    printf("循环结束，继续闪灯\n");
    const uint LED_PIN = PICO_DEFAULT_LED_PIN;
    gpio_init(LED_PIN);
    gpio_set_dir(LED_PIN, GPIO_OUT);
    while (true) {
        gpio_put(LED_PIN, 1); sleep_ms(200);
        gpio_put(LED_PIN, 0); sleep_ms(200);
    }
    return 0;
}
EOF
    ;;

  pio)
    if [[ "$LANG_SEL" == "cpp" ]]; then HEAD='#include <cstdio>'; else HEAD='#include <stdio.h>'; fi
cat > "$SRC_FILE" <<EOF
$HEAD
#include "pico/stdlib.h"
#include "hardware/pio.h"
#include "square_wave.pio.h"     // 由 CMake 在编译时自动生成

#define OUT_PIN 15
#define FREQ_HZ 1000

int main() {
    stdio_init_all();
    sleep_ms(1500);               // 等 USB 串口枚举完成

    PIO pio = pio0;
    uint sm = pio_claim_unused_sm(pio, true);
    uint offset = pio_add_program(pio, &square_wave_program);

    square_wave_program_init(pio, sm, offset, OUT_PIN, 16, FREQ_HZ);

    printf("方波已启动: GP%d, %d Hz\n", OUT_PIN, FREQ_HZ);
    printf("状态机 %u，指令偏移 %u\n", sm, offset);

    while (true) {
        tight_loop_contents();
    }
    return 0;
}
EOF
    ;;

  empty)
    if [[ "$LANG_SEL" == "cpp" ]]; then HEAD='#include <cstdio>'; else HEAD='#include <stdio.h>'; fi
cat > "$SRC_FILE" <<EOF
$HEAD
#include "pico/stdlib.h"

int main() {
    stdio_init_all();

    printf("Hello from Pico\n");

    while (true) {
        tight_loop_contents();
    }
    return 0;
}
EOF
    ;;
esac

