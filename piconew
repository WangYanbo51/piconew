fi

case "$STARTER" in
  blink)
    if [[ "$LANG_SEL" == "cpp" ]]; then
cat > "$SRC_FILE" <<'EOF'
#include <cstdio>
#include "pico/stdlib.h"

// 板载 LED：官方 Pico / Pico 2 是 GP25
#ifndef PICO_DEFAULT_LED_PIN
#define PICO_DEFAULT_LED_PIN 25
#endif

int main() {
    stdio_init_all();

    const uint LED_PIN = PICO_DEFAULT_LED_PIN;
    gpio_init(LED_PIN);
    gpio_set_dir(LED_PIN, GPIO_OUT);

    int count = 0;
    while (true) {
        gpio_put(LED_PIN, 1);
        printf("LED ON   (%d)\n", ++count);
        sleep_ms(500);

        gpio_put(LED_PIN, 0);
        printf("LED OFF  (%d)\n", count);
        sleep_ms(500);
    }
    return 0;
}
EOF
    else
cat > "$SRC_FILE" <<'EOF'
#include <stdio.h>
#include "pico/stdlib.h"

// 板载 LED：官方 Pico / Pico 2 是 GP25
#ifndef PICO_DEFAULT_LED_PIN
#define PICO_DEFAULT_LED_PIN 25
#endif

int main() {
    stdio_init_all();

    const uint LED_PIN = PICO_DEFAULT_LED_PIN;
    gpio_init(LED_PIN);
    gpio_set_dir(LED_PIN, GPIO_OUT);

    int count = 0;
    while (true) {
        gpio_put(LED_PIN, 1);
        printf("LED ON   (%d)\n", ++count);
